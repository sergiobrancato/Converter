# Normalise line endings so the project builds the same on Windows, macOS and Linux.
* text=auto eol=lf

# Windows launchers need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Gradle wrapper scripts must keep LF (a CRLF shebang breaks them on Unix).
gradlew text eol=lf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.jar binary
*.wav binary
*.ttf binary
